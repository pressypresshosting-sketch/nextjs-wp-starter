# Copy to .env and fill in every value. This is the only file to fill in.
#
# `npm run deploy` ships the first three values to the server and writes the
# secret into the WordPress plugin's settings file. The PRESSY_* values never
# leave this machine. Do not `source` this file in a shell: a password with
# @ or ^ in it breaks, and the scripts read the file safely themselves.

# WordPress base URL, no trailing slash, no /wp-json. Example: https://cms.example
WP_URL=

# Public URL of this app. A domain root (https://app.example), or the path the
# host proxies (https://site.example/news). Inlined at build time.
NEXT_PUBLIC_SITE_URL=

# Shared secret for the refresh webhook. Generate: openssl rand -hex 32
REVALIDATE_SECRET=

# ---- Deploy settings, read by `npm run deploy`. Never uploaded. ----

# SSH login, as user@host
PRESSY_SSH=
# SSH password. Leave empty to use an SSH key or the normal prompt.
PRESSY_PASSWORD=
# SSH port
PRESSY_PORT=22
# Remote folder for the app, relative to the SSH home. The panel's startup
# command names it: with the default, `node news/entry.js`.
PRESSY_DIR=news
# Remote folder holding wp-config.php, relative to the SSH home. The deploy
# installs the WordPress plugin there. Leave empty to install it by hand.
PRESSY_WP_DIR=public_html
