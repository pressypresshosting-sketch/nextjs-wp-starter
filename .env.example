# Copy to .env and fill in every value.

# WordPress base URL, no trailing slash, no /wp-json. Example: https://cms.example
WP_URL=

# Public URL of this app. A domain root (https://app.example), or the path the
# host proxies (https://site.example/news). Inlined at build time.
NEXT_PUBLIC_SITE_URL=

# Shared secret for the refresh webhook of mu-plugin. Generate: openssl rand -hex 32
REVALIDATE_SECRET=

# ---- Deploy settings, read by `npm run deploy`. ----

# SSH login, as user@host
PRESSY_SSH=
PRESSY_PASSWORD= # SSH password. Leave empty to use an SSH key or the normal prompt.
PRESSY_PORT=22

# Remote folder for the app, relative to the SSH home. "." means root. 
# The panel's startup command names it: with the default, `node (yourappfolder/)entry.js`.
PRESSY_DIR=.
# Remote folder holding wp-config.php, relative to your root folder.
PRESSY_WP_DIR=public_html

# ---- Read only by docs/prompt-workflow.md. Never uploaded, never read by ----
# ---- the app. Skip this section unless you are building with the prompts. --
#
# Your WordPress admin access is NOT a setting here: it follows from the values
# above. PRESSY_SSH plus PRESSY_WP_DIR means the agent can run wp-cli on the
# WordPress host and fix CMS-side problems itself. With PRESSY_SSH empty, or
# WordPress on a host you cannot reach, it must hand those problems back to you
# instead. Fill the deploy settings in before Prompt 1 and it works this out.

# What the host tolerates before it starts refusing connections. The one fact
# no amount of inspection reveals - you find out by being banned, and a shared
# host running fail2ban takes out SSH and HTTPS together. Leave empty and the
# agent assumes a strict limit, which is the safe default.
WORKFLOW_HOST_RATE_LIMIT=8 requests / 60s

# Where the front end will run, if you already know. The default matches this
# starter's own deployment. Other answers: vercel, docker, static-export.
# Leave empty and Prompt 1 picks the simplest target the topology supports and
# labels it an assumption for Prompt 3 to confirm.
WORKFLOW_DEPLOYMENT_TARGET=node-on-shared-ssh-host
