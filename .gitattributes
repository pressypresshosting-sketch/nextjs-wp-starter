# Keep line endings sane across Windows, macOS and Linux.
# Without this, a clone on Windows can rewrite the shell scripts with CRLF,
# and they then fail on macOS and Linux with "bad interpreter".
* text=auto eol=lf

# Never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.zip binary

# Files that must stay LF whatever the platform.
*.sh text eol=lf
*.cjs text eol=lf
*.mjs text eol=lf
*.php text eol=lf
